---
import { Image } from 'astro:assets';
import imgRequerimiento from '../assets/images/operario-corte-madera-medida.png';
import imgDiseno from '../assets/images/planta-tarimas-apiladas.png';
import imgEntrega from '../assets/images/montacargas-tablones-nave.png';
import Icono from './Icono.astro';

const pasos = [
  {
    numero: '1',
    titulo: '1- Envíanos tu requerimiento',
    cuerpo: 'Medidas, capacidad de carga, volumen mensual y destino.',
    imagen: imgRequerimiento,
    alt: 'Operario midiendo con precisión un tablón de madera',
  },
  {
    numero: '2',
    titulo: '2- Recibe diseño y precio',
    cuerpo: 'Un asesor te propone la tarima adecuada y su cotización.',
    imagen: imgDiseno,
    alt: 'Tarimas de madera estándar apiladas en la nave de producción',
  },
  {
    numero: '3',
    titulo: '3- Producimos y entregamos',
    cuerpo: 'Fabricamos y llevamos tu pedido con flota propia.',
    imagen: imgEntrega,
    alt: 'Montacargas trasladando tablones de madera para su entrega',
  },
];
---

<section id="proceso" class="seccion proceso">
  <div class="contenedor">
    <div class="seccion-cabecera seccion-cabecera--ancha rv" style="margin-inline:auto; text-align:center;">
      <h2 class="titulo-seccion" style="max-width:none">Cotiza tarimas o embalajes en 3 pasos</h2>
    </div>

    <ol class="proceso__linea">
      {
        pasos.map((p, i) => (
          <li class="proceso__paso rv" style={`transition-delay:${i * 90}ms`}>
            <span class="proceso__badge" aria-hidden="true">
              {p.numero}
            </span>
            <div class="proceso__media">
              <Image
                src={p.imagen}
                alt={p.alt}
                widths={[320, 480, 640, 860]}
                sizes="(min-width: 820px) 30vw, 92vw"
                loading="lazy"
                class="proceso__imagen"
              />
            </div>
            <h3>{p.titulo}</h3>
            <p>{p.cuerpo}</p>
          </li>
        ))
      }
    </ol>

    <div class="proceso__cta rv">
      <a
        class="boton boton--amarillo"
        href="https://wa.me/528183013487"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icono nombre="whatsapp" />
        Cotizar por WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .proceso {
    background: var(--blanco);
  }

  .proceso__linea {
    margin-top: var(--space-7);
    display: grid;
    gap: var(--space-7);
  }

  .proceso__paso {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 3.6rem;
  }

  .proceso__badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--azul);
    color: var(--amarillo);
    font-weight: var(--peso-extrabold);
    font-size: 1.1rem;
    border: 3px solid var(--blanco);
  }

  /* Riel de la línea de tiempo: vertical en móvil, horizontal en escritorio */
  .proceso__paso:not(:last-child)::after {
    content: '';
    position: absolute;
    background: var(--amarillo);
    z-index: 1;
  }

  .proceso__paso:not(:last-child)::after {
    top: 1.3rem;
    left: 50%;
    width: 2px;
    height: calc(100% + var(--space-7) - 1.3rem);
    transform: translateX(-50%);
  }

  .proceso__media {
    width: 100%;
  }

  .proceso__imagen {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radio-md);
  }

  .proceso__paso h3 {
    margin-top: var(--space-4);
    font-size: var(--tamano-titulo-tarjeta);
  }

  .proceso__paso p {
    margin-top: 0.5rem;
    color: var(--texto-suave);
    max-width: 32ch;
  }

  .proceso__cta {
    margin-top: var(--space-6);
    display: flex;
    justify-content: center;
  }

  @media (min-width: 820px) {
    .proceso__linea {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }

    .proceso__paso:not(:last-child)::after {
      top: 1.3rem;
      left: 50%;
      width: calc(100% + var(--space-5));
      height: 2px;
      transform: none;
    }
  }
</style>
