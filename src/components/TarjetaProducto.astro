---
import Icono from './Icono.astro';

interface Props {
  titulo: string;
  compacta?: boolean;
  icono?: 'tarima' | 'embalaje' | 'madera' | 'tratamiento' | 'cepillada' | 'triplay';
}

const { titulo, compacta = false, icono } = Astro.props;
---

<article class:list={['tarjeta-producto', { 'tarjeta-producto--compacta': compacta }]}>
  {icono && <span class="tarjeta-producto__icono"><Icono nombre={icono} /></span>}
  <h3 class="tarjeta-producto__titulo">{titulo}</h3>
  <p class="tarjeta-producto__cuerpo"><slot /></p>
</article>

<style>
  .tarjeta-producto {
    position: relative;
    height: 100%;
    min-height: 9.5rem;
    padding: var(--space-4);
    overflow: hidden;
    background: var(--blanco);
    border: 1px solid rgba(255, 255, 255, 0.54);
    border-radius: var(--radio-md);
    box-shadow: 0 22px 46px -34px rgba(0, 0, 0, 0.9);
    transition:
      transform var(--dur-base) var(--ease-estandar),
      border-color var(--dur-base) var(--ease-estandar),
      box-shadow var(--dur-base) var(--ease-estandar);
  }

  .tarjeta-producto:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 171, 0, 0.72);
    box-shadow: 0 30px 58px -34px rgba(0, 0, 0, 0.92);
  }

  .tarjeta-producto__titulo {
    position: relative;
    z-index: 1;
    font-size: var(--tamano-titulo-tarjeta);
    color: var(--texto);
    max-width: 23ch;
  }

  .tarjeta-producto__icono {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    margin-bottom: var(--space-3);
    border-radius: 50%;
    background: var(--amarillo);
    color: var(--azul);
    font-size: 1.4rem;
  }

  .tarjeta-producto__cuerpo {
    margin-top: 0.5rem;
    color: var(--texto-suave);
    max-width: 34ch;
  }

  .tarjeta-producto--compacta {
    padding: var(--space-4);
  }

  .tarjeta-producto--compacta .tarjeta-producto__titulo {
    font-size: var(--tamano-titulo-tarjeta);
  }

  .tarjeta-producto--compacta .tarjeta-producto__cuerpo {
    font-size: var(--tamano-pequeno);
    margin-top: 0.35rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta-producto {
      transition: none;
    }

    .tarjeta-producto:hover {
      transform: none;
    }
  }
</style>
