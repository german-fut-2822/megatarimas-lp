const monterrey: [number, number] = [247.8, 102.2];
const puntos = [
  { nombre: 'Coahuila', xy: [214, 114] as [number, number] },
  { nombre: 'Tamaulipas', xy: [291, 72] as [number, number] },
  { nombre: 'San Luis Potosí / Guanajuato', xy: [234.9, 168.2] as [number, number] },
];
---

<svg class="mapa-mx" viewBox="0 0 437 254" aria-hidden="true" focusable="false">
  <path d={contorno} class="mapa-mx__contorno" />

  {
    puntos.map((p) => (
      <line
        x1={monterrey[0]}
        y1={monterrey[1]}
        x2={p.xy[0]}
        y2={p.xy[1]}
        class="mapa-mx__linea"
      />
    ))
  }

  {
    puntos.map((p) => (
      <circle cx={p.xy[0]} cy={p.xy[1]} r="4" class="mapa-mx__punto" />
    ))
  }

  <circle cx={monterrey[0]} cy={monterrey[1]} r="6.5" class="mapa-mx__hub" />
  <text x={monterrey[0] + 11} y={monterrey[1] - 8} class="mapa-mx__etiqueta mapa-mx__etiqueta--hub">
    Monterrey
  </text>
</svg>

<style>
  .mapa-mx {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .mapa-mx__contorno {
    fill: rgba(255, 171, 0, 0.08);
    stroke: var(--amarillo);
    stroke-width: 1.6;
  }

  .mapa-mx__linea {
    stroke: rgba(255, 171, 0, 0.55);
    stroke-width: 1.3;
    stroke-dasharray: 3 4;
  }

  .mapa-mx__punto {
    fill: var(--natural);
    stroke: var(--amarillo);
    stroke-width: 1.5;
  }

  .mapa-mx__hub {
    fill: var(--amarillo);
    stroke: var(--papel);
    stroke-width: 2;
  }

  .mapa-mx__etiqueta {
    font-family: var(--fuente);
    font-weight: var(--peso-bold);
    font-size: 11px;
    fill: var(--blanco);
  }

  .mapa-mx__etiqueta--hub {
    fill: var(--amarillo);
  }
</style>
