---
import { Image } from 'astro:assets';
import imagen from '../assets/images/detalle-tablones-madera.png';
import TarjetaProducto from './TarjetaProducto.astro';
import WoodGrain from './WoodGrain.astro';

const productos = [
  { titulo: 'Madera para tarimas', cuerpo: 'Pino en medidas para fabricar o reparar tarimas.', icono: 'tarima' },
  {
    titulo: 'Madera para embalaje',
    cuerpo: 'Para cajas, huacales y madera para embalaje de exportación.',
    icono: 'embalaje',
  },
  {
    titulo: 'Madera de pino industrial',
    cuerpo: 'Maderas industriales para empaque, construcción de bases y uso en planta.',
    icono: 'madera',
  },
  {
    titulo: 'Madera tratada industrial',
    cuerpo: 'Madera certificada con tratamiento térmico, lista para embalaje de exportación.',
    icono: 'tratamiento',
  },
  { titulo: 'Madera cepillada', cuerpo: 'Acabado uniforme para piezas que lo requieren.', icono: 'cepillada' },
  { titulo: 'Triplay industrial', cuerpo: 'Para tapas, bases y embalaje cerrado.', icono: 'triplay' },
];
---

<section id="madera" class="madera">
  <Image
    src={imagen}
    alt="Vista cercana de tablones de madera industrial apilados, mostrando la veta y el corte uniforme"
    widths={[640, 960, 1400, 1920]}
    sizes="100vw"
    loading="lazy"
    class="madera__fondo"
  />
  <div class="madera__degradado" aria-hidden="true"></div>
  <div class="madera__veta" aria-hidden="true">
    <WoodGrain corner="top-right" color="rgba(255,171,0,0.45)" />
  </div>

  <div class="contenedor madera__interior">
    <div class="madera__encabezado rv">
      <div class="madera__copy">
        <span class="etiqueta-marca">MADERA INDUSTRIAL</span>
        <h2 class="titulo-seccion" style="margin-top:0.9rem; color:var(--blanco)">
          Madera para tarimas, embalaje e industria
        </h2>
        <p class="texto-guia" style="color:rgba(255,255,255,0.86)">
          La misma madera con la que fabricamos nuestras tarimas y embalaje, disponible para tu
          planta o taller.
        </p>
        <a class="boton boton--amarillo" href="#cotizacion">Cotizar Ahora</a>
      </div>
    </div>

    <div class="madera__lista">
      {
        productos.map((p, i) => (
          <div class="madera__producto rv rv--scale" style={`transition-delay:${i * 70}ms`}>
            <TarjetaProducto titulo={p.titulo} icono={p.icono} compacta>
              {p.cuerpo}
            </TarjetaProducto>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .madera {
    position: relative;
    isolation: isolate;
    background: var(--carbon);
    overflow: hidden;
  }

  .madera :global(.madera__fondo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    z-index: -2;
  }

  .madera__degradado {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, rgba(32, 35, 38, 0.98) 0%, rgba(32, 35, 38, 0.78) 42%, rgba(32, 35, 38, 0.22) 100%),
      linear-gradient(100deg, rgba(32, 35, 38, 0.98) 0%, rgba(32, 35, 38, 0.88) 48%, rgba(32, 35, 38, 0.2) 100%);
  }

  .madera__veta {
    position: absolute;
    top: 0;
    right: 0;
    width: min(30vw, 18rem);
    aspect-ratio: 1;
    z-index: -1;
    pointer-events: none;
  }

  .madera__interior {
    padding-block: var(--space-7);
  }

  .madera__encabezado {
    padding-bottom: var(--space-6);
  }

  .madera__encabezado .texto-guia {
    max-width: 48ch;
  }

  .madera__copy .boton {
    margin-top: var(--space-4);
  }

  .madera__lista {
    display: grid;
    gap: var(--space-3);
  }

  .madera__producto {
    height: 100%;
  }

  @media (min-width: 720px) {
    .madera__lista {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }

  @media (min-width: 960px) {
    .madera__degradado {
      background:
        linear-gradient(0deg, rgba(32, 35, 38, 0.9) 0%, rgba(32, 35, 38, 0.3) 56%, rgba(32, 35, 38, 0.08) 100%),
        linear-gradient(100deg, rgba(32, 35, 38, 0.99) 0%, rgba(32, 35, 38, 0.92) 48%, rgba(32, 35, 38, 0.22) 100%);
    }

    .madera__lista {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
