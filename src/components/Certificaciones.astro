---
import { Image } from 'astro:assets';
import nwpca from '../assets/certificaciones/nwpca.png';
import iso9001 from '../assets/certificaciones/iso-9001.png';
import ispm15 from '../assets/certificaciones/ispm-15.png';
import nom from '../assets/certificaciones/nom.png';
import WoodGrain from './WoodGrain.astro';

const logos = [
  { src: ispm15, alt: 'Sello IPPC ISPM 15 Certified', nombre: 'ISPM-15' },
  { src: nom, alt: 'Logotipo NOM', nombre: 'NOM-144' },
  { src: iso9001, alt: 'Logotipo ISO 9001:2015', nombre: 'ISO 9001' },
  { src: nwpca, alt: 'Logotipo de la National Wooden Pallet & Container Association', nombre: 'NWPCA' },
];
---

<section id="certificaciones" class="seccion certificaciones">
  <div class="certificaciones__veta" aria-hidden="true">
    <WoodGrain corner="top-left" color="rgba(255,171,0,0.28)" />
  </div>

  <div class="contenedor certificaciones__layout">
    <div class="seccion-cabecera certificaciones__copy rv rv--left">
      <h2 class="titulo-seccion">Certificaciones</h2>
      <p class="texto-guia">
        Cada tarima sale de planta lista para pasar inspección, en México y en frontera.
      </p>
    </div>

    <div class="certificaciones__logos">
      {
        logos.map((l, i) => (
          <div class="cert-card rv rv--scale" style={`transition-delay:${i * 70}ms`}>
            <div class="cert-card__media">
              <Image
                src={l.src}
                alt={l.alt}
                widths={[160, 240, 320]}
                sizes="(min-width: 960px) 13vw, (min-width: 640px) 18vw, 32vw"
                loading="lazy"
                class="cert-card__logo"
              />
            </div>
            <span class="cert-card__etiqueta">{l.nombre}</span>
          </div>
        ))
      }

      <div class="cert-card rv rv--scale" style="transition-delay:280ms">
        <div class="cert-card__media">
          <img src="/certificaciones/fsc.svg" alt="Logotipo FSC (Forest Stewardship Council)" class="cert-card__logo cert-card__logo--fsc" loading="lazy" />
        </div>
        <span class="cert-card__etiqueta">FSC</span>
      </div>
    </div>
  </div>
</section>

<style>
  .certificaciones {
    position: relative;
    isolation: isolate;
    background: var(--azul);
    overflow: hidden;
  }

  .certificaciones__veta {
    position: absolute;
    top: 0;
    left: 0;
    width: min(36vw, 24rem);
    aspect-ratio: 1;
    z-index: -1;
    pointer-events: none;
  }

  .certificaciones__layout {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .certificaciones__copy {
    margin: 0;
  }

  .certificaciones__copy :global(.titulo-seccion) {
    color: var(--blanco);
  }

  .certificaciones__copy :global(.texto-guia) {
    color: rgba(255, 255, 255, 0.78);
    max-width: 34ch;
  }

  .certificaciones__logos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    width: 100%;
  }

  .cert-card {
    position: relative;
    min-height: 9rem;
    overflow: hidden;
    background: var(--blanco);
    border-radius: var(--radio-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: var(--sombra-suave);
    transition:
      transform var(--dur-base) var(--ease-estandar),
      box-shadow var(--dur-base) var(--ease-estandar);
  }

  .cert-card__media {
    width: 100%;
    height: 5.25rem;
    display: grid;
    place-items: center;
  }

  .cert-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 56px -32px rgba(0, 0, 0, 0.55);
  }

  .cert-card:last-child {
    grid-column: 1 / -1;
    width: calc((100% - var(--space-3)) / 2);
    justify-self: center;
  }

  :global(.cert-card__logo) {
    width: min(100%, 11rem);
    max-height: 5.25rem;
    object-fit: contain;
    transition: transform var(--dur-lenta) var(--ease-estandar);
  }

  :global(.cert-card__logo--fsc) {
    width: 4.5rem;
    max-height: 5.25rem;
  }

  .cert-card__etiqueta {
    display: block;
    margin-top: var(--space-2);
    color: var(--azul);
    font-size: var(--tamano-pequeno);
    font-weight: var(--peso-extrabold);
    line-height: 1.2;
    text-align: center;
  }

  .cert-card:hover :global(.cert-card__logo) {
    transform: scale(1.06);
  }

  @media (min-width: 640px) {
    .certificaciones__logos {
      grid-template-columns: repeat(6, 1fr);
      row-gap: var(--space-4);
    }

    /* Pirámide: 3 tarjetas arriba, 2 abajo centradas en los espacios */
    .cert-card:nth-child(1) {
      grid-column: 1 / 3;
    }

    .cert-card:nth-child(2) {
      grid-column: 3 / 5;
    }

    .cert-card:nth-child(3) {
      grid-column: 5 / 7;
    }

    .cert-card:nth-child(4) {
      grid-column: 2 / 4;
    }

    .cert-card:nth-child(5) {
      grid-column: 4 / 6;
      width: auto;
      justify-self: stretch;
    }
  }

  @media (min-width: 960px) {
    .certificaciones__layout {
      grid-template-columns: minmax(17rem, 0.7fr) minmax(0, 1.3fr);
      gap: clamp(3rem, 6vw, 6rem);
    }

    .cert-card {
      min-height: 10.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cert-card,
    :global(.cert-card__logo) {
      transition: none;
    }

    .cert-card:hover,
    .cert-card:hover :global(.cert-card__logo) {
      transform: none;
    }
  }
</style>
