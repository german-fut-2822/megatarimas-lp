---
import { Image } from 'astro:assets';
import nwpca from '../assets/certificaciones/nwpca.png';
import iso9001 from '../assets/certificaciones/iso-9001.png';
import ispm15 from '../assets/certificaciones/ispm-15.png';
import nom from '../assets/certificaciones/nom.png';
import WoodGrain from './WoodGrain.astro';

const logos = [
  { src: ispm15, alt: 'Sello IPPC ISPM 15 Certified', nombre: 'ISPM-15' },
  { src: nom, alt: 'Logotipo NOM', nombre: 'NOM-144' },
  { src: iso9001, alt: 'Logotipo ISO 9001:2015', nombre: 'ISO 9001' },
  { src: nwpca, alt: 'Logotipo de la National Wooden Pallet & Container Association', nombre: 'NWPCA' },
];
---

<section id="certificaciones" class="seccion certificaciones">
  <div class="certificaciones__veta" aria-hidden="true">
    <WoodGrain corner="top-left" color="rgba(255,171,0,0.28)" />
  </div>

  <div class="contenedor">
    <div class="seccion-cabecera rv" style="margin-inline:auto; text-align:center;">
      <h2 class="titulo-seccion" style="color:var(--blanco); max-width:none">Certificaciones</h2>
      <p class="texto-guia" style="color:rgba(255,255,255,0.78); margin-inline:auto">
        Cada tarima sale de planta lista para pasar inspección, en México y en frontera.
      </p>
    </div>

    <div class="certificaciones__logos">
      {
        logos.map((l, i) => (
          <div class="cert-card rv" style={`transition-delay:${i * 60}ms`}>
            <Image
              src={l.src}
              alt={l.alt}
              widths={[160, 240, 320]}
              sizes="(min-width: 960px) 13vw, (min-width: 640px) 18vw, 32vw"
              loading="lazy"
              class="cert-card__logo"
            />
            <span class="cert-card__etiqueta">{l.nombre}</span>
          </div>
        ))
      }

      <div class="cert-card rv" style="transition-delay:240ms">
        <img src="/certificaciones/fsc.svg" alt="Logotipo FSC (Forest Stewardship Council)" class="cert-card__logo" loading="lazy" />
        <span class="cert-card__etiqueta">FSC</span>
      </div>
    </div>
  </div>
</section>

<style>
  .certificaciones {
    position: relative;
    isolation: isolate;
    background: var(--azul);
    overflow: hidden;
  }

  .certificaciones__veta {
    position: absolute;
    top: 0;
    left: 0;
    width: min(36vw, 24rem);
    aspect-ratio: 1;
    z-index: -1;
    pointer-events: none;
  }

  .certificaciones__logos {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    max-width: 50rem;
    margin-inline: auto;
  }

  .cert-card {
    background: var(--blanco);
    border-radius: var(--radio-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: var(--space-3) var(--space-2);
    box-shadow: var(--sombra-suave);
  }

  :global(.cert-card__logo) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 3.5rem;
    object-fit: contain;
  }

  .cert-card__etiqueta {
    font-weight: var(--peso-extrabold);
    font-size: 0.85rem;
    color: var(--azul);
    text-align: center;
    letter-spacing: 0.01em;
  }

  @media (min-width: 640px) {
    .certificaciones__logos {
      grid-template-columns: repeat(6, 1fr);
      row-gap: var(--space-5);
    }

    :global(.cert-card__logo) {
      max-height: 4rem;
    }

    /* Pirámide: 3 tarjetas arriba, 2 abajo centradas en los espacios */
    .cert-card:nth-child(1) {
      grid-column: 1 / 3;
    }

    .cert-card:nth-child(2) {
      grid-column: 3 / 5;
    }

    .cert-card:nth-child(3) {
      grid-column: 5 / 7;
    }

    .cert-card:nth-child(4) {
      grid-column: 2 / 4;
    }

    .cert-card:nth-child(5) {
      grid-column: 4 / 6;
    }
  }
</style>
