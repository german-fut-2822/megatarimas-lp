---
import { Image } from 'astro:assets';
import imagen from '../assets/images/sello-tratamiento-termico.png';
import WoodGrain from './WoodGrain.astro';

const certificaciones = ['NOM-144', 'ISPM-15', 'ISO 9001', 'NWPCA', 'FSC'];
---

<section id="certificaciones" class="seccion certificaciones">
  <div class="certificaciones__veta" aria-hidden="true">
    <WoodGrain corner="top-left" color="rgba(255,171,0,0.28)" />
  </div>

  <div class="contenedor certificaciones__grid">
    <div class="certificaciones__texto">
      <div class="seccion-cabecera rv">
        <h2 class="titulo-seccion" style="color:var(--blanco)">Certificaciones</h2>
        <p class="texto-guia" style="color:rgba(255,255,255,0.78)">
          Cada tarima sale de planta lista para pasar inspección, en México y en frontera.
        </p>
      </div>

      <ul class="certificaciones__lista">
        {
          certificaciones.map((c, i) => (
            <li class="rv" style={`transition-delay:${i * 60}ms`}>
              {c}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="certificaciones__media rv">
      <Image
        src={imagen}
        alt="Sello de tratamiento térmico HT con la marca MX-991 estampado sobre una tarima de madera, conforme a NOM-144 e ISPM-15"
        widths={[380, 560, 760]}
        sizes="(min-width: 960px) 28vw, 80vw"
        loading="lazy"
        class="certificaciones__imagen"
      />
    </div>
  </div>
</section>

<style>
  .certificaciones {
    position: relative;
    isolation: isolate;
    background: var(--azul);
    overflow: hidden;
  }

  .certificaciones__veta {
    position: absolute;
    top: 0;
    left: 0;
    width: min(36vw, 24rem);
    aspect-ratio: 1;
    z-index: -1;
    pointer-events: none;
  }

  .certificaciones__grid {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .certificaciones__lista {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    max-width: 30rem;
  }

  .certificaciones__lista li {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radio-sm);
    padding: 0.9rem 1rem;
    font-weight: var(--peso-extrabold);
    font-size: 1.05rem;
    color: var(--amarillo);
    text-align: center;
  }

  .certificaciones__lista li:last-child {
    grid-column: 1 / -1;
  }

  .certificaciones__media {
    border-radius: var(--radio-md);
    overflow: hidden;
    justify-self: center;
    width: min(100%, 26rem);
  }

  .certificaciones__imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 720px) {
    .certificaciones__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .certificaciones__lista li:last-child {
      grid-column: auto;
    }
  }

  @media (min-width: 960px) {
    .certificaciones__grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
</style>
