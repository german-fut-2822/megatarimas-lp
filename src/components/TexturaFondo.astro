---
import { Image } from 'astro:assets';
import textura from '../assets/images/textura-vetas-mega.jpeg';

interface Props {
  intensidad?: number;
  posicion?: string;
  class?: string;
}

const {
  intensidad = 0.14,
  posicion = 'center',
  class: className = '',
} = Astro.props;
---

<div
  class:list={['textura-fondo', className]}
  style={`--textura-opacidad:${intensidad}; --textura-posicion:${posicion};`}
  aria-hidden="true"
>
  <Image
    src={textura}
    alt=""
    widths={[640, 960, 1376]}
    sizes="100vw"
    quality={78}
    loading="lazy"
    class="textura-fondo__imagen"
  />
</div>

<style>
  .textura-fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    pointer-events: none;
  }

  .textura-fondo :global(.textura-fondo__imagen) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--textura-posicion);
    opacity: var(--textura-opacidad);
    mix-blend-mode: multiply;
    filter: saturate(0.82) contrast(1.04);
    transform: scale(1.025);
  }

  .textura-fondo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.58));
  }

  @media (max-width: 639px) {
    .textura-fondo {
      opacity: 0.74;
    }

    .textura-fondo :global(.textura-fondo__imagen) {
      object-position: 42% center;
    }
  }
</style>
