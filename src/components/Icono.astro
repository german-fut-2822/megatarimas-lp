---
interface Props {
  nombre:
    | 'produccion'
    | 'inventario'
    | 'secado'
    | 'flota'
    | 'check'
    | 'whatsapp'
    | 'ubicacion'
    | 'telefono'
    | 'correo'
    | 'flecha'
    | 'menu'
    | 'cerrar'
    | 'chevron';
  class?: string;
}

const { nombre, class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nombre === 'produccion' && (
      <>
        <path d="M3 20V9l5 3.5V9l5 3.5V9l5 3.5V20Z" />
        <path d="M3 20h18" />
        <path d="M7 20v-4M12 20v-4M17 20v-4" />
      </>
    )
  }
  {
    nombre === 'inventario' && (
      <>
        <path d="M3 8 12 4l9 4-9 4-9-4Z" />
        <path d="M3 8v8l9 4 9-4V8" />
        <path d="M12 12v8" />
      </>
    )
  }
  {
    nombre === 'secado' && (
      <>
        <circle cx="12" cy="9" r="4" />
        <path d="M12 2v1.5M19 9h1.5M4.5 9H3M17.2 3.8l-1 1M7.8 3.8l1 1" />
        <path d="M4 18c1.2-1.3 2.4-1.3 3.6 0 1.2 1.3 2.4 1.3 3.6 0 1.2-1.3 2.4-1.3 3.6 0 1.2 1.3 2.4 1.3 3.6 0" />
      </>
    )
  }
  {
    nombre === 'flota' && (
      <>
        <path d="M3 16V7a1 1 0 0 1 1-1h9v10" />
        <path d="M13 10h4l3 3v3h-7" />
        <circle cx="7.5" cy="17.5" r="1.75" />
        <circle cx="17" cy="17.5" r="1.75" />
      </>
    )
  }
  {nombre === 'check' && <path d="m5 12.5 4.5 4.5L19 7" />}
  {
    nombre === 'whatsapp' && (
      <>
        <path d="M7 18.5 3.5 20l1.55-3.78A7.5 7.5 0 1 1 7 18.5Z" />
        <path d="M8.8 8.6c0-.5.4-.9.9-.9h.5c.3 0 .55.2.65.5l.5 1.4c.1.25 0 .55-.2.75l-.5.5c.4.9 1.1 1.6 2 2l.5-.5c.2-.2.5-.3.75-.2l1.4.5c.3.1.5.35.5.65v.5c0 .5-.4.9-.9.9-3 0-5.6-2.6-5.6-5.6Z" />
      </>
    )
  }
  {
    nombre === 'ubicacion' && (
      <>
        <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z" />
        <circle cx="12" cy="10" r="2.5" />
      </>
    )
  }
  {nombre === 'telefono' && <path d="M5 4h3.2l1.3 4-2 1.5a11 11 0 0 0 5 5l1.5-2 4 1.3V17a2 2 0 0 1-2.2 2A15 15 0 0 1 3 6.2 2 2 0 0 1 5 4Z" />}
  {
    nombre === 'correo' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {nombre === 'flecha' && <path d="M5 12h13M13 6l6 6-6 6" />}
  {nombre === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {nombre === 'cerrar' && <path d="M5 5l14 14M19 5 5 19" />}
  {nombre === 'chevron' && <path d="m6 9 6 6 6-6" />}
</svg>

<style>
  :global(svg) {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }
</style>
