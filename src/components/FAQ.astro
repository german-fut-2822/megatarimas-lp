---
import { Image } from 'astro:assets';
import fondoFaq from '../assets/images/faq-tarimas-planta.png';
import Icono from './Icono.astro';
import WoodGrain from './WoodGrain.astro';

const preguntas = [
  {
    q: '¿Fabrican tarimas a la medida?',
    a: 'Sí. Diseñamos tarimas especiales de madera según dimensiones, capacidad de carga y uso de tu operación.',
  },
  {
    q: '¿Sus tarimas tienen tratamiento térmico?',
    a: 'Sí. Todas nuestras tarimas llevan tratamiento térmico y secado controlado, y cumplen NOM-144 e ISPM-15 para exportación.',
  },
  {
    q: '¿Venden tarimas por mayoreo?',
    a: 'Sí. Con capacidad de hasta 8,000 tarimas al día atendemos pedidos recurrentes y de alto volumen.',
  },
  {
    q: '¿A dónde entregan?',
    a: 'Nuevo León, Coahuila, Tamaulipas, San Luis Potosí y Guanajuato, con flota propia.',
  },
  {
    q: '¿Fabrican huacales y cajas de madera a la medida?',
    a: 'Sí. Diseñamos cajas y huacales según las dimensiones, el peso y la fragilidad de lo que vas a enviar, desde refacciones hasta maquinaria.',
  },
  {
    q: '¿Su embalaje sirve para exportación?',
    a: 'Sí. Nuestro embalaje industrial lleva tratamiento térmico y cumple NOM-144 e ISPM-15, así que puede cruzar frontera sin contratiempos.',
  },
];
---

<section id="faq" class="seccion faq">
  <Image
    src={fondoFaq}
    alt=""
    widths={[640, 960, 1400, 1920]}
    sizes="100vw"
    loading="lazy"
    class="faq__fondo"
    aria-hidden="true"
  />
  <div class="faq__degradado" aria-hidden="true"></div>
  <div class="faq__veta" aria-hidden="true">
    <WoodGrain corner="bottom-right" color="rgba(255,171,0,0.38)" />
  </div>

  <div class="contenedor faq__grid">
    <div class="seccion-cabecera faq__copy rv rv--left">
      <span class="etiqueta-marca">PREGUNTAS</span>
      <h2 class="titulo-seccion" style="margin-top:0.9rem">Preguntas frecuentes</h2>
    </div>

    <div class="faq__lista">
      {
        preguntas.map((item, i) => (
          <details class="faq__item rv" style={`transition-delay:${i * 50}ms`}>
            <summary>
              <span>{item.q}</span>
              <Icono nombre="chevron" class="faq__chevron" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    position: relative;
    isolation: isolate;
    background: var(--carbon);
    overflow: hidden;
  }

  .faq :global(.faq__fondo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -3;
  }

  .faq__degradado {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(0deg, rgba(255, 171, 0, 0.1) 0%, transparent 24%),
      linear-gradient(90deg, rgba(32, 35, 38, 0.66) 0%, rgba(32, 35, 38, 0.48) 44%, rgba(32, 35, 38, 0.34) 100%),
      linear-gradient(180deg, rgba(32, 35, 38, 0.42) 0%, rgba(32, 35, 38, 0.12) 72%, rgba(32, 35, 38, 0.04) 100%);
  }

  .faq .titulo-seccion {
    color: var(--blanco);
  }

  .faq__veta {
    position: absolute;
    bottom: 0;
    right: 0;
    width: min(60vw, 42rem);
    aspect-ratio: 1;
    z-index: -1;
    opacity: 0.55;
    pointer-events: none;
  }

  .faq__grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .faq__lista {
    display: grid;
    gap: var(--space-2);
  }

  .faq__item {
    background: rgba(32, 35, 38, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-left: 3px solid rgba(255, 171, 0, 0.8);
    border-radius: 0;
    padding-inline: var(--space-3);
    backdrop-filter: blur(8px);
    transition:
      border-color var(--dur-base) var(--ease-estandar),
      background var(--dur-base) var(--ease-estandar);
  }

  .faq__item[open] {
    background: rgba(32, 35, 38, 0.9);
    border-color: var(--amarillo);
  }

  .faq__item summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: 1rem;
    font-weight: var(--peso-bold);
    color: var(--blanco);
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  :global(.faq__chevron) {
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--amarillo);
    transition: transform var(--dur-base) var(--ease-estandar);
  }

  .faq__item[open] :global(.faq__chevron) {
    transform: rotate(180deg);
  }

  .faq__item p {
    padding-bottom: var(--space-3);
    color: rgba(255, 255, 255, 0.76);
    max-width: 62ch;
  }

  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: minmax(15rem, 0.62fr) minmax(0, 1.38fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .faq__copy {
      margin: 0;
      padding-top: var(--space-2);
    }
  }
</style>
