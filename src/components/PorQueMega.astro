---
import { Image } from 'astro:assets';
import imagen from '../assets/images/montacargas-tablones-nave.png';
import Icono from './Icono.astro';

const razones = [
  {
    icono: 'produccion' as const,
    numero: '8,000',
    numeroEtiqueta: 'tarimas estándar al día',
    titulo: 'Producción que no se detiene',
    cuerpo: 'Hasta 8,000 tarimas estándar al día, listas para tu operación.',
  },
  {
    icono: 'inventario' as const,
    numero: '1,000 m²',
    numeroEtiqueta: 'de materia prima almacenada',
    titulo: 'Inventario para entregas inmediatas',
    cuerpo: '1,000 m² de materia prima almacenada para responder rápido.',
  },
  {
    icono: 'secado' as const,
    titulo: 'Secado controlado',
    cuerpo: 'Menos humedad y más vida útil, sin deformaciones ni fallas.',
  },
  {
    icono: 'flota' as const,
    titulo: 'Flota propia de reparto',
    cuerpo: 'Entregamos con nuestras unidades y personal especializado.',
  },
];
---

<section id="por-que" class="seccion porque">
  <div class="contenedor">
    <div class="porque__principal rv rv--scale">
      <div class="seccion-cabecera seccion-cabecera--ancha porque__copy">
        <span class="etiqueta-marca">POR QUÉ MEGA TARIMAS</span>
        <h2 class="titulo-seccion">El proveedor de tarimas de madera que tu operación necesita</h2>
        <p class="texto-guia">Producción, inventario y entrega en una sola empresa.</p>
      </div>

      <div class="porque__banner">
        <Image
          src={imagen}
          alt="Montacargas trasladando un bloque de tablones de madera recién cortados dentro de la nave de producción"
          widths={[640, 960, 1280]}
          sizes="(min-width: 960px) 55vw, 100vw"
          loading="lazy"
          class="porque__imagen"
        />
      </div>
    </div>

    <div class="porque__lista">
      {
        razones.map((r, i) => (
          <article class="porque__tarjeta rv" style={`transition-delay:${i * 80}ms`}>
            <Icono nombre={r.icono} class="porque__icono" />
            {r.numero ? (
              <p class="porque__numero">
                {r.numero}
                <span>{r.numeroEtiqueta}</span>
              </p>
            ) : null}
            <h3>{r.titulo}</h3>
            <p>{r.cuerpo}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .porque {
    background: var(--blanco);
  }

  .porque__principal {
    display: grid;
    overflow: hidden;
    background: var(--azul);
    border-radius: var(--radio-md);
    box-shadow: 0 34px 70px -42px rgba(1, 37, 72, 0.85);
  }

  .porque__copy {
    position: relative;
    z-index: 2;
    margin: 0;
    padding: clamp(2rem, 4.5vw, 3.5rem);
    align-self: center;
  }

  .porque__copy :global(.titulo-seccion) {
    margin-top: var(--space-3);
    color: var(--blanco);
    max-width: 20ch;
    font-size: clamp(2rem, 1.72rem + 1vw, 2.5rem);
  }

  .porque__copy :global(.texto-guia) {
    color: rgba(255, 255, 255, 0.78);
    max-width: 34ch;
  }

  .porque__banner {
    position: relative;
    min-height: 20rem;
    overflow: hidden;
  }

  .porque__banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--azul) 0%, rgba(1, 58, 111, 0.3) 30%, rgba(1, 58, 111, 0) 64%);
    pointer-events: none;
  }

  .porque__banner :global(.porque__imagen) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .porque__lista {
    position: relative;
    z-index: 3;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
    margin: calc(var(--space-4) * -1) var(--space-2) 0;
  }

  .porque__tarjeta {
    height: 100%;
    background: var(--blanco);
    border-radius: var(--radio-md);
    padding: var(--space-4);
    border: 1px solid var(--borde);
    box-shadow: var(--sombra-suave);
    transition:
      transform var(--dur-base) var(--ease-estandar),
      box-shadow var(--dur-base) var(--ease-estandar);
  }

  .porque__tarjeta:hover {
    transform: translateY(-5px);
    box-shadow: 0 30px 56px -30px rgba(1, 37, 72, 0.46);
  }

  :global(.porque__icono) {
    width: 2.4rem;
    height: 2.4rem;
    padding: 0.55rem;
    color: var(--azul);
    background: rgba(255, 171, 0, 0.16);
    border-radius: var(--radio-sm);
  }

  .porque__numero {
    margin-top: var(--space-2);
    font-weight: var(--peso-extrabold);
    font-size: clamp(1.9rem, 1.3vw + 1.6rem, 2.4rem);
    color: var(--azul);
    line-height: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .porque__numero span {
    font-weight: var(--peso-bold);
    font-size: var(--tamano-pequeno);
    color: var(--texto-suave);
  }

  .porque__tarjeta h3 {
    margin-top: var(--space-2);
    font-size: var(--tamano-titulo-tarjeta);
  }

  .porque__tarjeta p:last-child {
    margin-top: 0.5rem;
    color: var(--texto-suave);
    font-size: var(--tamano-pequeno);
  }

  @media (min-width: 640px) {
    .porque__lista {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .porque__principal {
      grid-template-columns: 1fr 1fr;
      min-height: 29rem;
    }

    .porque__banner {
      min-height: 29rem;
    }

    .porque__banner::after {
      background: linear-gradient(90deg, var(--azul) 0%, rgba(1, 58, 111, 0.62) 18%, rgba(1, 58, 111, 0) 56%);
    }

    .porque__lista {
      grid-template-columns: repeat(4, 1fr);
      margin: calc(var(--space-5) * -1) var(--space-4) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .porque__tarjeta {
      transition: none;
    }

    .porque__tarjeta:hover {
      transform: none;
    }
  }
</style>
