---
import { Image } from 'astro:assets';
import imagen from '../assets/images/operario-corte-madera-medida.png';

const opciones = [
  'Estándar 48 × 40 in',
  'A la medida / sobre diseñoTarimas para exportación (tratamiento térmico)',
  'Cajas o huacales de madera',
  'Embalaje industrial o para exportación',
  'Madera industrial',
  'Aún no lo sé, necesito asesoría',
];
---

<section id="cotizacion" class="seccion cotizacion">
  <div class="contenedor cotizacion__grid">
    <div class="cotizacion__encabezado">
      <div class="seccion-cabecera rv" style="margin-bottom:0">
        <h2 class="titulo-seccion">Cotización de tarimas y embalaje de madera</h2>
        <p class="texto-guia">
          Cuéntanos qué necesitas y un asesor te responde con propuesta y precio.
        </p>
      </div>

      <div class="cotizacion__media rv">
        <Image
          src={imagen}
          alt="Operario ajustando con precisión un tablón de madera para una cotización a la medida"
          widths={[320, 480, 640]}
          sizes="(min-width: 960px) 26vw, 90vw"
          loading="lazy"
          class="cotizacion__imagen"
        />
      </div>
    </div>

    <!--
      TODO: conectar este formulario a un endpoint/servicio de envío cuando el
      cliente lo proporcione. Por ahora el envío solo se intercepta en el
      navegador (ver script abajo) y no se transmite a ningún destino.
    -->
    <form class="formulario rv" id="formulario-cotizacion">
      <div class="formulario__campo">
        <label for="nombre">Nombre</label>
        <input type="text" id="nombre" name="nombre" autocomplete="name" required />
      </div>

      <div class="formulario__campo">
        <label for="empresa">Empresa</label>
        <input type="text" id="empresa" name="empresa" autocomplete="organization" />
      </div>

      <div class="formulario__campo">
        <label for="telefono">Teléfono</label>
        <input type="tel" id="telefono" name="telefono" autocomplete="tel" required />
      </div>

      <div class="formulario__campo">
        <label for="correo">Correo Empresarial</label>
        <input type="email" id="correo" name="correo" autocomplete="email" required />
      </div>

      <div class="formulario__campo formulario__campo--ancho">
        <label for="necesidad">¿Qué necesitas?</label>
        <select id="necesidad" name="necesidad" required>
          <option value="" disabled selected hidden>Selecciona una opción</option>
          {opciones.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>

      <div class="formulario__campo">
        <label for="piezas">Piezas al mes (aprox.)</label>
        <input type="number" id="piezas" name="piezas" min="0" inputmode="numeric" />
      </div>

      <div class="formulario__campo">
        <label for="ciudad">Ciudad de entrega</label>
        <input type="text" id="ciudad" name="ciudad" autocomplete="address-level2" />
      </div>

      <div class="formulario__campo formulario__campo--ancho">
        <label for="mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="4"></textarea>
      </div>

      <div class="formulario__campo formulario__campo--ancho">
        <button type="submit" class="boton boton--amarillo">Solicitar cotización Ahora</button>
      </div>
    </form>
  </div>
</section>

<style>
  .cotizacion {
    background: var(--papel);
  }

  .cotizacion__encabezado {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-5);
  }

  .cotizacion__media {
    border-radius: var(--radio-md);
    overflow: hidden;
  }

  .cotizacion__imagen {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  @media (min-width: 960px) {
    .cotizacion__encabezado {
      grid-template-columns: 1.3fr 0.7fr;
    }
  }

  .formulario {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-3) var(--space-4);
    grid-template-columns: 1fr;
    background: var(--blanco);
    padding: var(--space-5);
    border-radius: var(--radio-md);
    border: 1px solid var(--borde-calido);
  }

  .formulario__campo {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .formulario__campo--ancho {
    grid-column: 1 / -1;
  }

  label {
    font-weight: var(--peso-bold);
    font-size: var(--tamano-pequeno);
    color: var(--tinta);
  }

  input,
  select,
  textarea {
    border: 1.5px solid var(--borde-calido);
    border-radius: var(--radio-sm);
    padding: 0.8rem 0.9rem;
    background: var(--papel);
    min-height: 44px;
  }

  textarea {
    resize: vertical;
    min-height: 7rem;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--azul);
    outline-offset: 1px;
    border-color: var(--azul);
  }

  .formulario button[type='submit'] {
    width: 100%;
  }

  @media (min-width: 720px) {
    .formulario {
      grid-template-columns: repeat(2, 1fr);
    }

    .formulario button[type='submit'] {
      width: auto;
      justify-self: start;
    }
  }
</style>

<script>
  const formulario = document.getElementById('formulario-cotizacion');
  // Sin backend todavía: solo se evita la navegación por defecto del navegador.
  formulario?.addEventListener('submit', (evento) => evento.preventDefault());
</script>
