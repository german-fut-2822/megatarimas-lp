---
import { Image } from 'astro:assets';
import imagen from '../assets/images/nave-tarimas-luz.png';

const opciones = [
  'Estándar 48 × 40 in',
  'A la medida / sobre diseñoTarimas para exportación (tratamiento térmico)',
  'Cajas o huacales de madera',
  'Embalaje industrial o para exportación',
  'Madera industrial',
  'Aún no lo sé, necesito asesoría',
];
---

<section id="cotizacion" class="cotizacion">
  <div class="cotizacion__layout">
    <div class="cotizacion__panel-form">
      <div class="contenedor cotizacion__interior">
        <div class="seccion-cabecera rv">
          <span class="etiqueta-marca">CONTACTO</span>
          <h2 class="titulo-seccion">Cotización de tarimas y embalaje de madera</h2>
          <p class="texto-guia">
            Cuéntanos qué necesitas y un asesor te responde con propuesta y precio.
          </p>
        </div>

        <!--
          TODO: conectar este formulario a un endpoint/servicio de envío cuando el
          cliente lo proporcione. Por ahora el envío solo se intercepta en el
          navegador (ver script abajo) y no se transmite a ningún destino.
        -->
        <form class="formulario rv" id="formulario-cotizacion">
          <div class="formulario__campo">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" autocomplete="name" required />
          </div>

          <div class="formulario__campo">
            <label for="empresa">Empresa</label>
            <input type="text" id="empresa" name="empresa" autocomplete="organization" />
          </div>

          <div class="formulario__campo">
            <label for="telefono">Teléfono</label>
            <input type="tel" id="telefono" name="telefono" autocomplete="tel" required />
          </div>

          <div class="formulario__campo">
            <label for="correo">Correo Empresarial</label>
            <input type="email" id="correo" name="correo" autocomplete="email" required />
          </div>

          <div class="formulario__campo formulario__campo--ancho">
            <label for="necesidad">¿Qué necesitas?</label>
            <select id="necesidad" name="necesidad" required>
              <option value="" disabled selected hidden>Selecciona una opción</option>
              {opciones.map((o) => <option value={o}>{o}</option>)}
            </select>
          </div>

          <div class="formulario__campo">
            <label for="piezas">Piezas al mes (aprox.)</label>
            <input type="number" id="piezas" name="piezas" min="0" inputmode="numeric" />
          </div>

          <div class="formulario__campo">
            <label for="ciudad">Ciudad de entrega</label>
            <input type="text" id="ciudad" name="ciudad" autocomplete="address-level2" />
          </div>

          <div class="formulario__campo formulario__campo--ancho">
            <label for="mensaje">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="4"></textarea>
          </div>

          <div class="formulario__campo formulario__campo--ancho">
            <button type="submit" class="boton boton--amarillo">Solicitar cotización Ahora</button>
          </div>
        </form>
      </div>
    </div>

    <div class="cotizacion__panel-imagen rv" aria-hidden="true">
      <Image
        src={imagen}
        alt=""
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 960px) 40vw, 100vw"
        loading="lazy"
        class="cotizacion__imagen"
      />
      <div class="cotizacion__degradado"></div>
    </div>
  </div>
</section>

<style>
  .cotizacion {
    position: relative;
    isolation: isolate;
    background: var(--papel);
    overflow: hidden;
  }

  .cotizacion__layout {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    min-width: 0;
  }

  .cotizacion__panel-form {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-width: 0;
    background: var(--papel);
  }

  .cotizacion__interior {
    padding-block: var(--space-7);
    min-width: 0;
  }

  .cotizacion :global(.titulo-seccion) {
    margin-top: 0.9rem;
  }

  .cotizacion__panel-imagen {
    position: relative;
    isolation: isolate;
    min-height: 18rem;
    min-width: 0;
  }

  .cotizacion__imagen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .cotizacion__degradado {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, var(--papel) 0%, rgba(253, 250, 246, 0.28) 38%, rgba(32, 35, 38, 0.28) 100%),
      linear-gradient(90deg, rgba(1, 58, 111, 0.16), rgba(32, 35, 38, 0.08));
  }

  .formulario {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-3) var(--space-4);
    grid-template-columns: 1fr;
    background: var(--blanco);
    padding: var(--space-5);
    border-radius: var(--radio-md);
    border: 1px solid var(--borde);
    box-shadow: var(--sombra-suave);
    min-width: 0;
  }

  .formulario__campo {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }

  .formulario__campo--ancho {
    grid-column: 1 / -1;
  }

  label {
    font-weight: var(--peso-bold);
    font-size: var(--tamano-pequeno);
    color: var(--texto);
  }

  input,
  select,
  textarea {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    border: 1.5px solid var(--borde);
    border-radius: var(--radio-sm);
    padding: 0.8rem 0.9rem;
    background: var(--blanco);
    min-height: 44px;
  }

  textarea {
    resize: vertical;
    min-height: 7rem;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--azul);
    outline-offset: 1px;
    border-color: var(--azul);
  }

  .formulario button[type='submit'] {
    width: 100%;
  }

  @media (min-width: 720px) {
    .formulario {
      grid-template-columns: repeat(2, 1fr);
    }

    .formulario button[type='submit'] {
      width: auto;
      justify-self: start;
    }
  }

  @media (min-width: 960px) {
    .cotizacion__layout {
      display: block;
    }

    .cotizacion__panel-imagen {
      position: absolute;
      inset: 0 0 0 44%;
      min-height: 100%;
      z-index: 0;
    }

    .cotizacion__panel-form {
      min-height: 100%;
      background: linear-gradient(
        90deg,
        var(--papel) 0%,
        var(--papel) 52%,
        rgba(253, 250, 246, 0.94) 62%,
        rgba(253, 250, 246, 0.52) 76%,
        rgba(253, 250, 246, 0) 100%
      );
    }

    .cotizacion__interior > :global(*) {
      width: min(56%, 46rem);
    }

    .cotizacion__degradado {
      background:
        linear-gradient(90deg, var(--papel) 0%, rgba(253, 250, 246, 0.86) 18%, rgba(253, 250, 246, 0.18) 68%, rgba(32, 35, 38, 0.18) 100%),
        linear-gradient(0deg, rgba(32, 35, 38, 0.28), rgba(1, 58, 111, 0.06) 54%, rgba(255, 255, 255, 0.08));
    }
  }
</style>

<script>
  const formulario = document.getElementById('formulario-cotizacion');
  // Sin backend todavía: solo se evita la navegación por defecto del navegador.
  formulario?.addEventListener('submit', (evento) => evento.preventDefault());
</script>
