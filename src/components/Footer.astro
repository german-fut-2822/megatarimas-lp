---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-mega-tarimas.png';
import Icono from './Icono.astro';
import WoodGrain from './WoodGrain.astro';

const navegacion = [
  { href: '#tarimas', texto: 'Tarimas' },
  { href: '#empaque', texto: 'Empaque' },
  { href: '#madera', texto: 'Madera' },
  { href: '#certificaciones', texto: 'Certificaciones' },
  { href: '#cobertura', texto: 'Cobertura' },
  { href: '#faq', texto: 'Preguntas' },
];
---

<footer class="footer">
  <div class="footer__veta" aria-hidden="true">
    <WoodGrain corner="top-right" color="rgba(255,171,0,0.38)" />
  </div>

  <div class="contenedor footer__grid">
    <div class="footer__marca">
      <Image src={logo} alt="MEGA Tarimas" width={140} height={58} class="footer__logo" />
      <p class="footer__descripcion">
        Tarimas, cajas, huacales y embalaje de madera para exportación, logística e industria.
      </p>
    </div>

    <nav class="footer__col" aria-label="Navegación del footer">
      <h2 class="footer__titulo">Navegación</h2>
      <ul class="footer__nav">
        {
          navegacion.map((n) => (
            <li>
              <a href={n.href}>{n.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__titulo">Ubicación</h2>
      <p class="footer__item">
        <Icono nombre="ubicacion" />
        <span>Callejón de los Tijerina #482, Unión Agropecuarios Lázaro Cárdenas del Norte, 66084
          Monterrey, N.L.</span>
      </p>
    </div>

    <div class="footer__col">
      <h2 class="footer__titulo">Contacto</h2>
      <p class="footer__item">
        <Icono nombre="telefono" />
        <a href="tel:+528183013487">+52 (81) 83013487</a>
      </p>
      <p class="footer__item">
        <Icono nombre="correo" />
        <a href="mailto:ventas@maderasgarza.com.mx">ventas@maderasgarza.com.mx</a>
      </p>
      <p class="footer__item footer__item--privacidad">
        <a href="https://www.megatarimas.mx/information/license.html" target="_blank" rel="noopener noreferrer">
          Aviso de privacidad
        </a>
      </p>
    </div>
  </div>

  <p class="footer__legal contenedor">© {new Date().getFullYear()} MEGA Tarimas.</p>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    background: var(--carbon);
    color: var(--blanco);
    padding-block: var(--space-7) var(--space-4);
    overflow: hidden;
  }

  .footer__veta {
    position: absolute;
    top: 0;
    right: 0;
    width: min(60vw, 42rem);
    aspect-ratio: 1;
    z-index: -1;
    pointer-events: none;
  }

  .footer__grid {
    display: grid;
    gap: var(--space-5);
  }

  .footer__logo {
    height: 2.4rem;
    width: auto;
    border-radius: var(--radio-sm);
  }

  .footer__descripcion {
    margin-top: var(--space-3);
    color: rgba(255, 255, 255, 0.72);
    max-width: 34ch;
  }

  .footer__titulo {
    font-size: 1rem;
    color: var(--amarillo);
    margin-bottom: var(--space-3);
  }

  .footer__nav {
    display: grid;
    gap: 0.6rem;
  }

  .footer__nav a {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.84);
    transition: color var(--dur-rapida) var(--ease-estandar);
  }

  .footer__nav a:hover {
    color: var(--amarillo);
  }

  .footer__item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin-top: 0.6rem;
    color: rgba(255, 255, 255, 0.84);
  }

  .footer__item a {
    text-decoration: none;
    color: inherit;
  }

  .footer__item a:hover {
    color: var(--amarillo);
  }

  .footer__item :global(svg) {
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.15rem;
    color: var(--amarillo);
  }

  .footer__item--privacidad {
    margin-top: var(--space-3);
  }

  .footer__legal {
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--borde-claro-sobre-oscuro);
    font-size: var(--tamano-micro);
    color: rgba(255, 255, 255, 0.58);
  }

  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1.3fr 0.8fr 1fr 1fr;
    }
  }

</style>
